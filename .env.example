# Copy to .env and fill in:  cp .env.example .env
# Guide: docs/02-supabase-setup.md. Deploying: docs/04-deploy.md.

# --- PUBLIC: VITE_ values are shipped to every visitor's browser ---

# Project Settings -> Data API -> URL (delete the /rest/v1/ at the end)
VITE_SUPABASE_URL=
# API Keys -> publishable (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to false before handing the app over
VITE_SHOW_DEMOS=true

# --- PRIVATE: server only. NEVER add VITE_ to these ---

# Leave this line alone - it copies the URL from above
SUPABASE_URL=${VITE_SUPABASE_URL}
# API Keys -> secret (sb_secret_...). It's a password: never put it in client/
SUPABASE_SECRET_KEY=
